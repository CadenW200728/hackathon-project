[sub_resource type="GDScript" id="GDScript_q6r6c"]
script/source = "extends Area2D

var direction: Vector2
var berry = 0
var lenny = 1
var mirror = 0
var scaleOs = 0

func _ready() -> void:
	var tween = get_tree().create_tween()
	tween.tween_property($Sprite2D, \"scale\", Vector2(0.3, 0.3), 0.1)

func setup(pos: Vector2, dir: Vector2) -> void:
	direction = dir.normalized()
	global_position = pos + direction * 40
	rotation = direction.angle()

	# reset everything to 0 first
	berry = 0
	lenny = 0
	mirror = 0
	scaleOs = 0

	# then set only the chosen one to 1 and swap the picture
	match Global1.selected_item:
		\"berry\":
			berry = 1
			$Sprite2D.texture = preload(\"res://items/berry.png\")
		\"lenny\":
			lenny = 1
			$Sprite2D.texture = preload(\"res://items/lennyHat.png\")
		\"mirror\":
			mirror = 1
			$Sprite2D.texture = preload(\"res://items/mirror.png\")
		\"scaleOs\":
			scaleOs = 1
			$Sprite2D.texture = preload(\"res://items/scaleOs.png\")
func _physics_process(delta: float) -> void:
	global_position += direction * 280 * delta
"

