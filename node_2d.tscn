[sub_resource type="GDScript" id="GDScript_qri1f"]
resource_name = "spawner"
script/source = "extends Node2D

var enemy_scene = preload(\"res://enemies.tscn\") 
@export var spawn_rng_range: float = 354.0  

var rng = RandomNumberGenerator.new()

func _ready() -> void:
	$Timer.timeout.connect(_on_timer_timeout)

func _on_timer_timeout() -> void:
	var enemy = enemy_scene.instantiate()
	enemy.position = global_position + Vector2(rng.randf_range(-361, 354.0),rng.randf_range(325, -454))
	get_parent().add_child(enemy)
"

