[sub_resource type="GDScript" id="GDScript_qri1f"]
resource_name = "enemies"
script/source = "extends CharacterBody2D

var colorRng = RandomNumberGenerator.new()
var color = 0
var green = 0
var red = 0
var purple = 0
var orange = 0

func _ready() -> void:
	color = colorRng.randi_range(0,3)
	if color == 0:
		$AnimatedSprite2D.play(\"walkEnemyGreen\")
		green = 1
		red = 0
		purple = 0
		orange = 0
	if color == 1:
		$AnimatedSprite2D.play(\"walkEnemyOrange\")
		orange = 1
		green = 0
		red = 0
		purple = 0
	if color == 2:
		$AnimatedSprite2D.play(\"walkEnemyPurple\")
		purple = 1
		orange = 0
		green = 0
		red = 0
	if color == 3:
		$AnimatedSprite2D.play(\"walkEnemyRed\")
		purple = 0
		orange = 0
		green = 0
		red = 1
	print(colorRng.randi_range(0,3))
"

